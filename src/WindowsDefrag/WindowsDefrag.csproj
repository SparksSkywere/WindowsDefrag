<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>WindowsDefrag</AssemblyName>
    <RootNamespace>WindowsDefrag</RootNamespace>
    <Product>Windows Defrag</Product>
    <Title>Windows Defrag</Title>
    <AssemblyTitle>Windows Defrag</AssemblyTitle>
    <Company>Skywere Industries</Company>
    <Authors>Skywere Industries</Authors>
    <Copyright>Copyright © Skywere Industries</Copyright>
    <Description>Analyse and defragment hard disks, TRIM solid-state drives, and inspect cluster allocation with a classic drive list and cluster map.</Description>
    <Version>1.0.7</Version>
    <FileVersion>1.0.7</FileVersion>
    <AssemblyVersion>1.0.7.0</AssemblyVersion>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\config.default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <Target Name="SyncProductionIcon" BeforeTargets="PrepareForBuild;BeforeBuild;BeforePublish">
    <PropertyGroup>
      <_InstallerIco>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\assets\installer.ico'))</_InstallerIco>
      <_AppIco>$(MSBuildProjectDirectory)\Assets\app.ico</_AppIco>
    </PropertyGroup>
    <Copy SourceFiles="$(_InstallerIco)" DestinationFiles="$(_AppIco)" SkipUnchangedFiles="false"
          Condition="Exists('$(_InstallerIco)')" />
    <Message Importance="high" Text="Synced app icon from assets\installer.ico" Condition="Exists('$(_InstallerIco)')" />
  </Target>

</Project>
