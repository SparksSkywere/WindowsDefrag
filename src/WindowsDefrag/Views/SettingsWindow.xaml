<Window x:Class="WindowsDefrag.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        Height="580" Width="540"
        MinHeight="460" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <DockPanel Margin="16" Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="88" Height="28" IsDefault="True" Margin="0,0,8,0"
                    Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Cancel" Width="88" Height="28" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme}"
                          DisplayMemberPath="Label"
                          Width="300" HorizontalAlignment="Left"/>
                <TextBlock Text="Default is System (follows Windows light/dark). Other options are era styles from Chronolog (Windows 95 through Windows 11 Dark)."
                           Style="{StaticResource MutedTextStyle}" Margin="0,6,0,12" TextWrapping="Wrap"/>

                <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}"/>
                <CheckBox Content="Confirm before defragmentation" IsChecked="{Binding ConfirmBeforeDefrag}"/>
                <CheckBox Content="Analyse the first HDD when the program starts" IsChecked="{Binding AnalyseOnStartup}"/>
                <CheckBox Content="Show removable drives" IsChecked="{Binding ShowRemovable}"/>
                <CheckBox Content="Shaded cluster view" IsChecked="{Binding ShadedView}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Cluster block size" VerticalAlignment="Center" Width="160"/>
                    <Slider Width="180" Minimum="4" Maximum="16" TickFrequency="2"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            Value="{Binding BlockSize}"/>
                    <TextBlock Text="{Binding BlockSize, StringFormat=0 px}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Text="SSD and safety" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,8"/>
                <CheckBox Content="Block classic defragmentation on SSD and NVMe (use TRIM)"
                          IsChecked="{Binding BlockSsd}"/>
                <CheckBox Content="Do not defragment while on battery" IsChecked="{Binding SkipBattery}"/>
                <CheckBox Content="Never move pagefile.sys / swapfile.sys" IsChecked="{Binding SkipPagefile}"/>
                <CheckBox Content="Never move hiberfil.sys" IsChecked="{Binding SkipHibernation}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Minimum free space" VerticalAlignment="Center" Width="160"/>
                    <Slider Width="180" Minimum="2" Maximum="25" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            Value="{Binding MinFree}"/>
                    <TextBlock Text="{Binding MinFree, StringFormat={}{0:0}%}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Schedule (daily job)" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Run at" VerticalAlignment="Center" Width="160"/>
                    <TextBox Width="40" Text="{Binding HourText}"/>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                    <TextBox Width="40" Text="{Binding MinuteText}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
