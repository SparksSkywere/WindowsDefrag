<Window x:Class="WindowsDefrag.Views.ClusterInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cluster inspector"
        Height="420" Width="720"
        MinHeight="320" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <DockPanel Margin="12" Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Width="88" Height="28" IsDefault="True" IsCancel="True"
                    Click="Close_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <DataGrid x:Name="FileGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fragments" Binding="{Binding Fragments}" Width="80"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource FileSize}}" Width="90"/>
                <DataGridTextColumn Header="Start LCN" Binding="{Binding StartLcn, StringFormat=N0}" Width="100"/>
                <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
